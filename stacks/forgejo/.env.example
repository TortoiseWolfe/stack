# ---------------------------------------------------------------- REQUIRED

# Namespaces Traefik across every stack on the same Traefik, or instances fight over a router.
INSTANCE_NAME=

# Staging trial: forgejo.staging.chattanooga.digital
FORGEJO_DOMAIN=

# Pinned tag, no floating major. Digest at pin time:
# sha256:fcd19ff4ebc85fb098a67e8e1d0d5a84d07dd6e8a23edcfdfd5b71a6178953be
FORGEJO_VERSION=17.0.1

DB_PASSWORD=

# Long random string. Encrypts stored tokens, so changing it later breaks them.
FORGEJO_SECRET_KEY=

# ---------------------------------------------------------------- OPTIONAL

# DISABLE_REGISTRATION=true
# MAIL_ENABLED=false
# MAIL_PROTOCOL=smtp+starttls
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=
# POSTGRES_VERSION=17-alpine
# MEM_LIMIT_APP=512M
# MEM_LIMIT_DB=256M
# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le
# PLACEMENT_CONSTRAINT=node.role == manager
