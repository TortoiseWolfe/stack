# ---------------------------------------------------------------- REQUIRED

# Namespaces Traefik across every stack on the same Traefik, or instances fight over a router.
INSTANCE_NAME=

# Staging trial: forgejo.staging.chattanooga.digital
FORGEJO_DOMAIN=

# Pinned to the 15.0 long-term-support line (supported to 15 July 2027, per
# forgejo.org/docs/latest/admin/release-schedule/). 17.0 is supported only to 28 January 2027.
# Digest at pin time:
# sha256:5d050e6d623e540923ff54b1c0c7acf41c3f9174a6c7ad515cc0c63d703fcd22
FORGEJO_VERSION=15.0.11

DB_PASSWORD=

# Long random string. Encrypts stored tokens, so changing it later breaks them.
FORGEJO_SECRET_KEY=

# ---------------------------------------------------------------- OPTIONAL

# DISABLE_REGISTRATION=true
# MAIL_ENABLED=false
# MAIL_PROTOCOL=smtp+starttls
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=
# POSTGRES_VERSION=17.12-alpine@sha256:34261f594522cf41dfcb76aefd42b9d201098b0e6b23c9c68733f169e4218b6f
# MEM_LIMIT_APP=512M
# MEM_LIMIT_DB=256M
# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le
# PLACEMENT_CONSTRAINT=node.role == manager
