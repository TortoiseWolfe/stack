# Paste the REQUIRED block into Portainer's stack environment panel.
# Keep secrets ALPHANUMERIC; Portainer mangles percent, asterisk and dollar.

# ---------------------------------------------------------------- REQUIRED

# Unique across every stack on the same Traefik, or instances fight over a router.
INSTANCE_NAME=

# Files and Office.
DOMAIN=

# Talk signaling. Its own Traefik router, distinct host from DOMAIN.
TALK_HOST=

# Refuses a database written by a newer version and will not skip a major, so
# pin a real tag and step one major at a time.
NEXTCLOUD_VERSION=
COLLABORA_VERSION=
WHITEBOARD_VERSION=

DB_PASSWORD=
REDIS_PASSWORD=

# Anything but `admin`; the built-in account is disabled once this one exists.
ADMIN_USER=
ADMIN_PASSWORD=

# nextcloud/docker splits this on spaces. The proxy overlay subnet, not every
# RFC1918 range, on a shared host.
TRUSTED_PROXIES=

# The turn stack's host and secret. Same value as its TURN_SECRET.
TURN_HOST=
TURN_SECRET=

# Generate each separately: openssl rand -hex 32
JWT_SECRET=
SIGNALING_SECRET=
TALK_INTERNAL_SECRET=

SMTP_PASSWORD=
# Sender is built as MAIL_FROM@MAIL_DOMAIN.
MAIL_DOMAIN=

# ---------------------------------------------------------------- OPTIONAL
# All have working defaults. Set only to override.

# Bump when scripts/init.sh changes; Swarm configs are immutable.
# INIT_CONFIG_NAME=nextcloud_init_1

# uid:Display Name:email, comma separated. The uid is the login and Nextcloud will
# not rename it later, so changing one means deleting the account and its files.
# Empty means a rebuild comes back with the service account alone and every real
# person is recreated by hand.
# ADMIN_ACCOUNTS=
# Ordinary members, same uid:name:email,... shape, placed in the `members` group
# rather than `admin`. Use this for pilot members and anyone who is there to USE
# the instance; ADMIN_ACCOUNTS makes someone an administrator of the whole thing.
# MEMBER_ACCOUNTS=raitch:Rob Aitchison:raitch@pm.me

# Space separated, appended to the app set every instance gets. Instance
# specific, so it lives here rather than in the script.
# EXTRA_APPS=

# TALK_ENABLED=true
# Has to match the turn stack's TURN_PORT.
# TURN_PORT=3478
# TALK_IMAGE=strangewill/aio-talk-standalone
# TALK_VERSION=20260428
# TALK_LOG_LEVEL=info

# POSTGRES_VERSION and the nextcloud_db volume move together.
# POSTGRES_VERSION=18
# REDIS_VERSION=7-alpine
# DB_NAME=nextcloud
# DB_USER=nextcloud

# Local part only. A full address yields no-reply@x@x and mail vanishes.
# MAIL_FROM=no-reply
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend

# Honoured at first install only. Adopting object storage later is a data
# migration, not a config change. Set all of them or none.
# S3_BUCKET=
# S3_HOST=
# S3_KEY=
# S3_SECRET=
# S3_PORT=443
# S3_REGION=us-east-1
# S3_SSL=true
# S3_USE_PATH_STYLE=true

# COLLABORA_DICTIONARIES=en_US
# PHP_MEMORY_LIMIT=1024M
# PHP_UPLOAD_LIMIT=10G
# UPLOAD_MAX_BYTES=10737418240

# TZ=America/New_York
# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le

# PLACEMENT_CONSTRAINT=node.role == manager
# MEM_LIMIT_APP=2G
# MEM_LIMIT_DB=1G
# MEM_LIMIT_REDIS=256M
# MEM_LIMIT_CRON=512M
# MEM_LIMIT_INIT=512M
# MEM_LIMIT_COLLABORA=2G
# MEM_LIMIT_WHITEBOARD=512M
# MEM_LIMIT_TALK=1G
# MEM_LIMIT_RECORDING_SHARE=256M

# Talk recordings are shared to the conversation they were recorded in, so the
# meeting record belongs to the room rather than to whoever pressed record.
# Set to 0 to leave recordings private to their owner (Talk's own default).
# RECORDING_AUTOSHARE=1
# RECORDING_SHARE_INTERVAL=120
# STT_SHARE_MIN_AGE=120

# Swarm configs are immutable: bump the name when the file changes, or the old
# content keeps running.
# SHARE_RECORDINGS_CONFIG_NAME=nextcloud_share_recordings_2

# REQUIRED -- compose uses ${VAR:?} for these three, so the stack refuses to start
# without them. They were added by the recording/transcription work and were missing
# here, which meant a deploy from this file could not boot.
#
# Pin these to an exact version rather than a floating tag. Under Swarm a floating
# tag is resolved to a digest at service-create and never re-resolved, so `:latest`
# reads as self-updating while actually being frozen to whatever was current on the
# day the service was made. Production's values as of 2026-09-01:
LOCALAI_VERSION=v4.9.0
TALK_RECORDING_VERSION=20260817_082005
# Shared secret between Talk and its recording backend; both sides must match.
# Generate with `openssl rand -hex 32`. Never commit a real value.
RECORDING_SECRET=
