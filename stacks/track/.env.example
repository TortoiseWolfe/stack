# Paste the REQUIRED block into Portainer's stack environment panel.
# Keep secrets ALPHANUMERIC; Portainer mangles percent, asterisk and dollar.

# ---------------------------------------------------------------- REQUIRED

# Namespaces this instance's Traefik router and service. Unique across every
# stack on the same Traefik. Lowercase, no spaces.
INSTANCE_NAME=

# Public hostname.
DOMAIN=

# Image tag for central and agents. Only sha-* tags are published so far.
TRACK_VERSION=sha-8eb4b9b

# Seeds the admin account on first start only. Changing it later does nothing;
# use the UI.
ADMIN_PASSWORD=

# Presented by every agent on push. openssl rand -hex 32
INGEST_KEY=

# ---------------------------------------------------------------- OPTIONAL
# All have working defaults. Set only to override.

# ADMIN_USER=admin
# ADMIN_EMAIL=admin@${DOMAIN}

# Group that owns /var/run/docker.sock on the nodes: stat -c '%g' /var/run/docker.sock
# Every node has to agree; the agent runs with this gid to read the socket.
# DOCKER_GID=988

# Seconds between readings, both agents and central.
# POLL_INTERVAL_SECONDS=15
# DISK_POLL_INTERVAL_SECONDS=300
# NODE_OFFLINE_AFTER_SECONDS=45

# Sample retention. Billing samples keep their own, much longer, retention.
# RETENTION_DAYS=14

# Traefik wiring
# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le

# Scheduling and resources. Applies to central only; agents run on every node.
# PLACEMENT_CONSTRAINT=node.role == manager
# MEM_LIMIT_TRACK=512M
# MEM_LIMIT_AGENT=256M
