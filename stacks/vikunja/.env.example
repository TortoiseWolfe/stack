# ---------------------------------------------------------------- REQUIRED

# Names this instance's Traefik router and service. Must be unique across every stack on the same Traefik, or instances fight over a router.
INSTANCE_NAME=

VIKUNJA_DOMAIN=

VIKUNJA_VERSION=2.8.0

DB_PASSWORD=

# Signs login sessions. Generate: openssl rand -base64 32
VIKUNJA_SECRET=

# ---------------------------------------------------------------- OPTIONAL

# Registration is off by default: create the first user from the container
# (see README), then leave it off and add people from the admin side.
# ENABLE_REGISTRATION=false

# Outgoing mail (reminders, password reset). Off until MAIL_ENABLED=true.
# MAIL_ENABLED=false
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=

# POSTGRES_VERSION=17-alpine
# MEM_LIMIT_APP=256M
# MEM_LIMIT_DB=256M
# TRAEFIK_NETWORK=traefik_net
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=le
# PLACEMENT_CONSTRAINT=node.role == manager
